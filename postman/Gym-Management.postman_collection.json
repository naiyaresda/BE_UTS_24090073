{
  "info": {
    "name": "Gym Management System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Jalankan berurutan folder 1-7 (klik kanan koleksi > Run collection). Database kosong/lama tidak masalah karena email & nama paket memakai timestamp."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const s = new Date(Date.now() + 5*86400000);",
          "s.setUTCHours(10,0,0,0);",
          "pm.collectionVariables.set('startTime', s.toISOString());",
          "pm.collectionVariables.set('endTime', new Date(s.getTime()+3600000).toISOString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Members",
      "item": [
        {
          "name": "Create member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "members"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Budi Santoso\",\n  \"email\": \"budi{{$timestamp}}@mail.com\",\n  \"phone\": \"08123456789\",\n  \"birthDate\": \"2000-05-20\",\n  \"gender\": \"male\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) pm.collectionVariables.set('memberId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
